<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/time_background"
    android:paddingStart="36dp"
    android:paddingTop="24dp"
    android:paddingEnd="36dp"
    android:paddingBottom="24dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/batteryStatus"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:drawableStart="@drawable/ic_battery_24"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="@string/battery_unknown"
        android:textColor="@color/time_secondary"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/elapsedStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/elapsedStatus"
        android:layout_width="150dp"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:drawableStart="@drawable/ic_stopwatch_24"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:text="@string/elapsed_placeholder"
        android:textColor="@color/time_secondary"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/batteryStatus" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dateText"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/date_placeholder"
        android:textColor="@color/time_muted"
        android:textSize="18sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="13sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/timerText"
        app:layout_constraintEnd_toStartOf="@id/actionRow"
        app:layout_constraintStart_toEndOf="@id/batteryStatus"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/timerText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="sans-serif-black"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:maxLines="1"
        android:text="@string/timer_placeholder"
        android:textColor="@color/time_primary"
        android:textSize="118sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="118sp"
        app:autoSizeMinTextSize="44sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/actionRow"
        app:layout_constraintStart_toEndOf="@id/batteryStatus"
        app:layout_constraintTop_toBottomOf="@id/dateText" />

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="44dp"
        android:layout_height="100dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/nightButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.72"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_night_mode"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_moon_24"
            android:tint="@color/time_secondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/fullscreenButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_fullscreen"
            android:padding="10dp"
            android:scaleType="center"
            android:src="@drawable/ic_fullscreen_24"
            android:tint="@color/time_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
